# Servidor
NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal | silent (por defecto: debug en desarrollo, info en producción)
LOG_LEVEL=debug
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Base de datos. Coincide con el servicio postgres del docker-compose.yml de la raíz
# (`docker compose up postgres`).
DATABASE_URL=postgresql://clena:clena@localhost:5432/clena
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=clena
DATABASE_USER=clena
DATABASE_PASSWORD=clena
# Opcional: base de las pruebas e2e. Por defecto, la de DATABASE_URL con el nombre clena_e2e.
# DATABASE_URL_E2E=postgresql://clena:clena@localhost:5432/clena_e2e

# JWT. Genera un secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_ACCESS_EXPIRES_IN_SEGUNDOS=900
# Los computadores de la sala son compartidos: sesiones cortas
REFRESH_TOKEN_TTL_HORAS=12

# Códigos de verificación
CODIGO_VERIFICACION_TTL_MINUTOS=10
CODIGO_VERIFICACION_MAX_INTENTOS=5
CODIGO_VERIFICACION_ESPERA_REENVIO_SEGUNDOS=60

# consola: imprime el código en los logs (solo desarrollo). Los proveedores reales se agregan después.
NOTIFICACIONES_PROVEEDOR=consola

# HU-04: administrador inicial que crea `pnpm prisma:seed`. La contraseña es temporal:
# se pide cambiarla en el primer ingreso. Usa valores propios, nunca estos en producción.
ADMIN_INICIAL_NOMBRE=Administrador CLENA
ADMIN_INICIAL_CORREO=admin@clena.example
ADMIN_INICIAL_PASSWORD=CambiaEsta2026

# Envío del código de verificación por canal. consola = solo lo escribe en los logs (desarrollo).
NOTIFICACIONES_CORREO=consola
NOTIFICACIONES_SMS=consola

# Correo real (NOTIFICACIONES_CORREO=smtp). Con Brevo: SMTP & API > SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE="Kamá CLENA <correo-verificado-en-brevo@ejemplo.com>"

# SMS real (NOTIFICACIONES_SMS=twilio). En Twilio: Console > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMERO_ORIGEN=

# SMS desde un Android propio con la app de textbee (NOTIFICACIONES_SMS=textbee).
# En textbee.dev: Dashboard > API key y Devices > Device ID.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

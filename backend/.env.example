NODE_ENV=development
PORT=3000
# trace | debug | info | warn | error | fatal | silent (por defecto: debug en desarrollo, info en producción)
LOG_LEVEL=debug

# Matches the postgres service of the root docker-compose.yml (`docker compose up postgres`).
DATABASE_URL=postgresql://clena:clena@localhost:5432/clena
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=clena
DATABASE_USER=clena
DATABASE_PASSWORD=clena
